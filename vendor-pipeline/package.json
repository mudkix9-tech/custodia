  },
  "devDependencies": {
    "@types/diff": "^5.2.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "@types/sqlite3": "^3.1.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
