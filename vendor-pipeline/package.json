{
  "name": "vendor-pipeline",
  "version": "1.0.0",
  "description": "Standalone data pipeline for tracking and verifying GDPR-related vendor claims and metadata.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
